# ---------------------------------------------------------------------------
# Production environment for admin-dashboard/  →  copy to
# admin-dashboard/.env.production
#
# Both values are baked in at BUILD time by next.config.js — a rebuild is
# required to change them.
#
# NEXT_PUBLIC_FRONTEND_URL matters: admin-dashboard/next.config.js falls back
# to an old Vercel URL (https://university-makran-taupe.vercel.app) when it is
# unset, so "view on site" links in the admin panel would point at a stale
# deployment instead of your own domain.
#
# Delete any admin-dashboard/.env.local on the server — it takes priority
# over this file.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=https://REPLACE_API_DOMAIN/api
NEXT_PUBLIC_FRONTEND_URL=https://REPLACE_DOMAIN
