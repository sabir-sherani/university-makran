# ---------------------------------------------------------------------------
# Production environment for backend/  →  copy to backend/.env on the server
#
# Every variable below is read somewhere in the backend code. Anything left
# blank degrades gracefully EXCEPT MONGO_URI and JWT_SECRET, which the app
# cannot run correctly without.
# ---------------------------------------------------------------------------

# --- Database (MongoDB Atlas) ----------------------------------------------
# Atlas → Database → Connect → Drivers. Replace <password> with the real one,
# URL-encode any special characters in it (@ becomes %40, # becomes %23).
# Keep the database name (/university_makran) before the "?".
MONGO_URI=mongodb+srv://ump_app:<password>@cluster0.xxxxx.mongodb.net/university_makran?retryWrites=true&w=majority

# --- Runtime ---------------------------------------------------------------
PORT=5000
NODE_ENV=production

# --- Auth ------------------------------------------------------------------
# Generate a NEW one for production, do not reuse the development value:
#   openssl rand -hex 48
JWT_SECRET=

# --- CORS ------------------------------------------------------------------
# Exact-match list, comma separated, no trailing slashes, no wildcards.
# app.js compares the browser's Origin header against these strings verbatim.
# Include the www form too if your DNS serves www.
ALLOWED_ORIGINS=https://REPLACE_DOMAIN,https://REPLACE_ADMIN_DOMAIN

# Used to build links inside outgoing emails (password resets etc).
FRONTEND_URL=https://REPLACE_DOMAIN

# --- Email (Gmail SMTP) ----------------------------------------------------
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your Gmail password:
# Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Scheduled job -------------------------------------------------------
# Protects POST /api/jobs/daily (absence alerts, document reminders).
# The cron entry sends it as the  x-job-secret  header.
#   openssl rand -hex 32
JOB_SECRET=

# --- File uploads (Cloudinary) — OPTIONAL ---------------------------------
# Leave ALL THREE blank to store uploads on the VPS disk at
# backend/public/uploads (persistent on a VPS, served via /uploads).
# Fill ALL THREE to store them on Cloudinary instead. There is no partial
# mode: utils/cloudinary.js switches on all three being present.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
