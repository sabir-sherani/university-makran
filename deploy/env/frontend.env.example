# ---------------------------------------------------------------------------
# Production environment for frontend/  →  copy to frontend/.env.production
#
# IMPORTANT: this value is baked into the JavaScript bundle at BUILD time by
# next.config.js. Changing it later requires a rebuild (`deploy.sh`), not just
# a PM2 restart.
#
# Also: delete any frontend/.env.local on the server. Next.js gives .env.local
# higher priority than .env.production, so a stale one pointing at
# http://localhost:5000/api silently overrides everything here.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=https://REPLACE_API_DOMAIN/api
