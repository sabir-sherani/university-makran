# ---------------------------------------------------------------------------
# deploy/deploy.env  —  single source of truth for the VPS deployment
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   nano deploy/deploy.env
#
# This file is read by setup-server.sh, render-nginx.sh and deploy.sh.
# It is gitignored. Keep it on the server only.
# ---------------------------------------------------------------------------

# --- Domains ---------------------------------------------------------------
# Root domain of the public website. The admin panel and API live on
# subdomains of it.
DOMAIN=example.edu.pk
ADMIN_DOMAIN=admin.example.edu.pk
API_DOMAIN=api.example.edu.pk

# Email Certbot uses for expiry notices.
LETSENCRYPT_EMAIL=you@example.com

# --- Where the code lives on the server ------------------------------------
APP_DIR=/var/www/university-makran
GIT_REPO=https://github.com/sabir-sherani/university-makran.git
GIT_BRANCH=main

# --- Ports the three Node processes listen on (localhost only) -------------
# Nginx proxies to these. Never open them in the firewall.
FRONTEND_PORT=3000
ADMIN_PORT=3001
BACKEND_PORT=5000

# --- Build tuning ----------------------------------------------------------
# Caps Node's heap during `next build`. 2048 is safe on a 4GB VPS,
# raise to 4096 on 8GB+.
BUILD_MAX_OLD_SPACE=2048
